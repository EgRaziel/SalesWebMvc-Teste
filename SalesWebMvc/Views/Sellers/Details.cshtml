@model SalesWebMvc.Models.Seller
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h2>Seller</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-1 text-sm-end">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-11">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-1 text-sm-end">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-11">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-1 text-sm-end">
            @Html.DisplayNameFor(model => model.BirthDate)
        </dt>
        <dd class="col-sm-11">
            @Html.DisplayFor(model => model.BirthDate)
        </dd>
        <dt class="col-sm-1 text-sm-end">
            @Html.DisplayNameFor(model => model.BaseSalary)
        </dt>
        <dd class="col-sm-11">
            @Html.DisplayFor(model => model.BaseSalary)
        </dd>
        <dt class="col-sm-1 text-sm-end">
            @Html.DisplayNameFor(model => model.Department)
        </dt>
        <dd class="col-sm-11">
            @Html.DisplayFor(model => model.Department.Name)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info">Edit</a> |
    <a asp-action="Index" class="btn btn-warning">Back to List</a>

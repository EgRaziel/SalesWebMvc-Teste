@model SalesWebMvc.Models.ViewModels.SellerFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit";
}

<h1>@ViewData["Title"]</h1>

<h4>Seller</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Seller.Id" />
            <fieldset>
                <div class="form-group">
                    <label asp-for="Seller.Name" class="form-label"></label>
                    <input asp-for="Seller.Name" class="form-control" placeholder="Enter Name" />
                    <span asp-validation-for="Seller.Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Seller.Email" class="form-label mt-2">Email</label>
                    <input asp-for="Seller.Email" type="email" class="form-control" placeholder="Enter Email" />
                    <span asp-validation-for="Seller.Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Seller.BirthDate" class="form-label mt-2">Birth Date</label>
                    <input asp-for="Seller.BirthDate" class="form-control" />
                    <span asp-validation-for="Seller.BirthDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="form-label mt-2">Base Salary</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="Seller.BaseSalary" type="text" class="form-control" aria-label="Amount" />
                    </div>
                    <span asp-validation-for="Seller.BaseSalary" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Seller.DepartmentId" class="form-label mt-2"></label>
                    <select class="form-select" asp-for="Seller.DepartmentId" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))"></select>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-success mt-3" />
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-warning mt-2">Back to List</a>
                </div>
            </fieldset>
        </form>
    </div>
</div>